{
  "realm": "lesson",
  "enabled": true,
  "users": [{
    "username": "user", "enabled": true,
    "firstName": "Test", "lastName": "User", "email": "user@example.com",
    "attributes": { "branchOfficeId": ["B42"] },
    "credentials": [{ "type": "password", "value": "user" }]
  }],
  "clients": [
    { "clientId": "app1", "secret": "app1-secret", "redirectUris": ["http://localhost:8081/login/oauth2/code/keycloak"],
      "protocolMappers": [{ "name": "branchOfficeId", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper",
        "config": { "user.attribute": "branchOfficeId", "claim.name": "branchOfficeId", "id.token.claim": "true" } }] },
    { "clientId": "app2", "secret": "app2-secret", "redirectUris": ["http://localhost:8082/login/oauth2/code/keycloak"],
      "serviceAccountsEnabled": true }
  ]
}
